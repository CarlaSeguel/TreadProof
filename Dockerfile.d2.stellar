FROM docker.io/stellar/stellar-cli@sha256:4c83ab3fb952748b30764f2a11f5df69173dd4e5aff8b122d1f39a7529a7c237 AS stellar-cli

FROM node:24-trixie-slim AS dependencies

WORKDIR /app/backend

COPY backend/package.json backend/package-lock.json ./

RUN npm ci --omit=dev --ignore-scripts \
    && npm cache clean --force

FROM node:24-trixie-slim

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=8080

WORKDIR /app

RUN groupadd --system treadproof \
    && useradd --system --gid treadproof treadproof

COPY --from=dependencies /app/backend/node_modules ./backend/node_modules

COPY backend/package.json ./backend/package.json
COPY deployments/testnet.json ./deployments/testnet.json
COPY backend/src/ ./backend/src/

COPY deploy/d2-public/ ./deploy/d2-public/
COPY deploy/d2-readonly-server.mjs ./deploy/d2-readonly-server.mjs
COPY deploy/d2-runtime-entrypoint.mjs ./deploy/d2-runtime-entrypoint.mjs

COPY --from=stellar-cli /usr/local/bin/stellar /usr/local/bin/stellar

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       libdbus-1-3 \
       ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN stellar --version

USER treadproof

EXPOSE 8080

CMD ["node", "deploy/d2-runtime-entrypoint.mjs"]