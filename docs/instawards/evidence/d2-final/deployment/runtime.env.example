# Actual runtime inputs; template only, not loaded. No credentials.
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
TREADPROOF_DEPLOYMENT_ORIGIN=https://treadproof-d2-demo.onrender.com
SUPABASE_URL=https://eviifvhdipdqhxzqxmbm.supabase.co
SUPABASE_PUBLISHABLE_KEY=
TP_HIGH1_LAB_DATABASE=treadproof_d2_high_integrated
# Choose explicitly. restored-local requires an authorized restored cluster first.
TP_D2_POSTGRES_MODE=restored-local
TP_D2_PGDATA=/var/lib/treadproof/postgres/data
TP_D2_SECRET_DIRECTORY=/etc/secrets
# Optional provenance inputs; use only actual final values, not the old D1 HEAD.
TREADPROOF_CODE_COMMIT=
TREADPROOF_BUILD_ID=
# Runtime-mounted secret files, not environment values:
# /etc/secrets/treadproof_pgpass
# /etc/secrets/treadproof_high1_pgpass
# No HIGH2-writer password or participant JWT/seed/private key is required.
